APP_NAME=SupportPilot AI
APP_ENV=local
API_PORT=8001

DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres

CHAT_SESSION_SECRET=replace-with-at-least-32-random-characters
CHAT_SESSION_TTL_MINUTES=480
WEB_ORIGIN=http://127.0.0.1:3000

SUPABASE_URL=http://host.docker.internal:55321
SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key

SUPABASE_LOCAL_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

SUPPORT_AGENT_EMAIL=agent@northstarcommerce.dev
SUPPORT_AGENT_PASSWORD=replace-with-local-password

SUPPORT_MANAGER_EMAIL=manager@northstarcommerce.dev
SUPPORT_MANAGER_PASSWORD=replace-with-local-password

SYSTEM_ADMIN_EMAIL=admin@northstarcommerce.dev
SYSTEM_ADMIN_PASSWORD=replace-with-local-password

EMAIL_INGEST_SECRET=replace-with-at-least-32-random-characters
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_HOST_PORT=5680

EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=1536

LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_NATIVE_DIMENSIONS=384
LOCAL_EMBEDDING_CACHE_DIR=/var/cache/fastembed

# Optional production provider.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30